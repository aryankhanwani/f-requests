# ---- FamCare backend -------------------------------------------------------
# Prod. Staging is https://backend.fixxoit.com/staging/api
FAMCARE_API_BASE_URL=
# Must be a SUPERADMIN account: GET /admin/requests resolves hub scope from the
# token, and a hub admin would only ever see their own hub's bookings.
FAMCARE_ADMIN_USERNAME=
FAMCARE_ADMIN_PASSWORD=

# ---- CTA target ------------------------------------------------------------
# No trailing slash. The button links to <this>/requests?id=<booking uuid>
ADMIN_PANEL_URL=https://admin.fixxoit.com

# ---- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram echoes it back on every webhook delivery.
TELEGRAM_WEBHOOK_SECRET=

# ---- Supabase --------------------------------------------------------------
SUPABASE_URL=
# Service role, NOT anon — the bot writes the claim ledger.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cron ------------------------------------------------------------------
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ---- Polling cadence (optional) -------------------------------------------
# One cron invocation runs this many passes, spaced this far apart, so latency
# is ~POLL_PASS_INTERVAL_MS rather than Vercel's 1-minute cron floor.
# passes * interval must stay under ~52s.
POLL_PASSES_PER_INVOCATION=4
POLL_PASS_INTERVAL_MS=15000
